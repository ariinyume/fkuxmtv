<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wake handling. This firmware refuses every third-party foreground service
         (AppsRelaunchController: isCallerSystem=false), so the screen-on listener is an
         accessibility service, which the system binds and keeps alive by itself.
         Usage access is optional: it only powers the screen-on foreground probe.
         Granted through app-ops, not at install time. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <package android:name="com.xiaomi.mitv.settings" />
        <package android:name="com.xiaomi.mitv.tvplayer" />
        <package android:name="com.mitv.tvhome" />
        <package android:name="com.android.settings" />
        <intent><action android:name="android.settings.ACCESSIBILITY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner" android:theme="@style/Theme.GuiZangTV"
        android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".FrameHomeActivity" android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:excludeFromRecents="true" android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Xiaomi's package-based startup hook resolves INFO before LAUNCHER.
             Ordinary TV app-list entries still open FrameHomeActivity directly. -->
        <activity android:name=".BootGateActivity" android:exported="true"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>
        <!-- Not running unless the user enables it in system accessibility settings, and it
             does nothing while the in-app switch is off. Reads package names only. -->
        <service android:name=".WakeAccessibilityService" android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
