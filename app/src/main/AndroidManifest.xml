<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wake handling. This firmware refuses every third-party foreground service
         (AppsRelaunchController: isCallerSystem=false), so the screen-on listener is an
         accessibility service, which the system binds and keeps alive by itself.
         Usage access is optional: it only powers the screen-on foreground probe.
         Granted through app-ops, not at install time. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Boot entry (plan A). RECEIVE_BOOT_COMPLETED gets us the broadcast;
         SYSTEM_ALERT_WINDOW is the Android 10+ exemption that makes the background
         activity start from that broadcast legal. The app-op must be allowed once via
         adb (pm grant / appops set) - on its own it silences nothing else. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Revival path: power-key standby runs PowerManagerService.killAllThirdApp, which
         force-stops us and strips our accessibility service from
         enabled_accessibility_services. Writing it back needs this permission, which is
         never granted at install time - it has to be declared here first, then granted
         once over adb (pm grant). Not declaring it makes pm grant fail with
         "has not requested permission". -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <package android:name="com.xiaomi.mitv.settings" />
        <package android:name="com.xiaomi.mitv.tvplayer" />
        <package android:name="com.mitv.tvhome" />
        <package android:name="com.android.settings" />
        <intent><action android:name="android.settings.ACCESSIBILITY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" /></intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner" android:theme="@style/Theme.GuiZangTV"
        android:allowBackup="false" android:supportsRtl="true">
        <!-- Deliberately NOT excludeFromRecents / clearTaskOnLaunch: when the task gets trimmed,
             the firmware recreates the activity on bring-back and the focus jumps to the first
             tile. Keeping the task alive keeps the selection where the user left it. -->
        <activity android:name=".FrameHomeActivity" android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Xiaomi's package-based startup hook resolves INFO before LAUNCHER.
             Ordinary TV app-list entries still open FrameHomeActivity directly. -->
        <activity android:name=".BootGateActivity" android:exported="true"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>
        <!-- Plan A: enter the home once per full boot, straight from the system broadcast.
             Everything is gated by BootStartPolicy (switch, model, once per boot), so a
             stray or duplicate broadcast does nothing. -->
        <receiver android:name=".BootReceiver" android:exported="true" android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Not running unless the user enables it in system accessibility settings, and it
             does nothing while the in-app switch is off. Reads package names only. -->
        <service android:name=".WakeAccessibilityService" android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
